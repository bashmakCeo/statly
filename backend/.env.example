# Скопируй в .env и заполни значения:
# cp .env.example .env

DATABASE_URL=postgresql+asyncpg://statly_user:CHANGE_ME@localhost:5432/statly

# development локально, production на сервере
APP_ENV=development

# Токен из @BotFather
TELEGRAM_BOT_TOKEN=

# URL Mini App
TELEGRAM_WEB_APP_URL=https://your-domain.example

# Локально можно true, на сервере обязательно false
ALLOW_INSECURE_INIT_DATA=false

SUBSCRIPTION_PRICE_RUB=500
SUBSCRIPTION_STARS_AMOUNT=500
SUBSCRIPTION_FREE_TRIAL_DAYS=14

# Бонус за подписку на Telegram-канал при истёкшей подписке
TELEGRAM_CHANNEL_BONUS_ID=
TELEGRAM_CHANNEL_BONUS_URL=
TELEGRAM_CHANNEL_BONUS_TITLE=
TELEGRAM_CHANNEL_BONUS_DAYS=5

CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_API_BASE_URL=https://pay.crypt.bot/api
